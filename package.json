{
  "name": "ielts-mastery-os",
  "version": "1.0.0",
  "description": "IELTS Mastery OS - Polyglot Learning Architecture",
  "type": "module",
  "scripts": {
    "dev:app": "tsx watch src/api/server.ts",
    "dev:ai": "cmd /c \"python -m uvicorn ai_engine.main:app --port 8001 --reload\"",
    "dev": "concurrently --kill-others-on-fail=false -p \"[{name}]\" -n \"APP,AI\" -c \"cyan,magenta\" \"npm run dev:app\" \"npm run dev:ai\"",
    "build": "tsc",
    "seed": "tsx src/db/seed.ts",
    "test:app": "vitest run",
    "test:ai": "cmd /c \"python -m pytest ai_engine/tests/ -v\"",
    "test:py": "cmd /c \"python -m pytest tests/test_app.py -v\"",
    "test": "vitest run && npm run test:py"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "ts-fsrs": "^5.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "concurrently": "^9.1.2",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
