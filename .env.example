# IELTS Mastery OS — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Server (Fastify / Node.js)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Security & Authentication
JWT_SECRET=ielts_mastery_os_super_secret_jwt_key_change_in_production

# Storage
DB_PATH=data/ielts_mastery.db

# AI Engine Bridge (FastAPI Python Daemon)
AI_ENGINE_URL=http://127.0.0.1:8001
